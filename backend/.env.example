# CampusCoins Backend Environment Variables
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Development Only - MUST BE FALSE IN PRODUCTION
ALLOW_DEV_MOCK_AUTH=false

# External AI Service (Optional - Rule-based NLP fallback will be used if omitted)
AI_SERVICE_URL=

# Supabase Production Database & Auth Integration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
